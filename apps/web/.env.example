# Base URL of the deployed apps/server Worker, e.g.
# https://ffdp-web-server.<your-subdomain>.workers.dev, or a custom domain
# routed to it. Only needed for production builds, where apps/web (Cloudflare
# Pages) and apps/server (Cloudflare Workers) are separate origins. Leave
# unset for local dev — Vite's dev proxy handles /rpc same-origin instead.
# Set this as a build-time environment variable in the Cloudflare Pages
# project settings, not by committing a real .env here.
VITE_SERVER_URL=https://ffdp-web-server.<your-subdomain>.workers.dev
